{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm install && npm run build -w console",
  "outputDirectory": "console/dist",
  "framework": null,
  "rewrites": [
    { "source": "/((?!fixtures/|assets/|favicon|icons).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/fixtures/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
    }
  ]
}
