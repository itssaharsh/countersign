{
  "name": "countersign",
  "manifest": {
    "model": {
      "name": "google-gemini/gemini-3-6-flash",
      "params": {
        "temperature": 0.1
      }
    },
    "instructions": "@agent/instructions.md",
    "mcp_servers": [
      {
        "name": "countersign",
        "enable_tools": [
          "@all"
        ],
        "require_approval_for_tools": [
          "commit_change",
          "fire_undo"
        ],
        "preload": true
      },
      {
        "name": "github",
        "enable_tools": [
          "pull_request_read",
          "get_file_contents",
          "list_pull_requests",
          "add_issue_comment"
        ],
        "require_approval_for_tools": [],
        "preload": true
      }
    ],
    "config": {
      "sandbox": {
        "enabled": true
      },
      "generative_ui": {
        "enabled": false
      },
      "ask_user_questions": {
        "enabled": true
      },
      "dynamic_sub_agents": {
        "enabled": true
      },
      "iteration_limit": 40
    },
    "skills": [
      {
        "name": "countersign-dossier"
      }
    ]
  }
}